# Placeholders only. Copy to .env.local (git-ignored) for local development.
APP_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=8100
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
RAG_AGENT_TOKEN=               # REQUIRED: random string, at least 24 characters
ALLOW_MOCK_PROVIDER=0          # 1 enables the test-only mock provider (ignored/forbidden when APP_ENV=production)
MAX_UPLOAD_BYTES=26214400
MAX_PAGES=500
MAX_TEXT_CHARS=2000000
PARSE_TIMEOUT_SECONDS=60
PARSE_MEMORY_MB=1024
CHUNK_TARGET_CHARS=3200
CHUNK_OVERLAP_CHARS=400
PROVIDER_TIMEOUT_SECONDS=60
MAX_CHAT_CHARS=60000
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.30
RETRIEVAL_MAX_CONTEXT_CHARS=12000
MAX_CONCURRENT_INGESTS=2
OCR_ENABLED=false
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=studyforge-rag-agent
LANGSMITH_INCLUDE_CONTENT=false
STREAM_IDLE_TIMEOUT_SECONDS=60

# --- Vector storage (backend/docs/VECTOR_STORE_SPEC.md). The default pgvector needs none of the PINECONE_* values. ---
# pgvector = PostgreSQL only (default) | dual = write both, SERVE PostgreSQL, compare Pinecone in the background | pinecone = serve semantic search from Pinecone.
# The backend's own VECTOR_STORE must be set to the SAME value. Pinecone credentials live ONLY here (never in the backend or the frontend).
VECTOR_STORE=pgvector
# Required for dual/pinecone. Use a placeholder here and put the real key in .env.local (git-ignored).
PINECONE_API_KEY=
# JSON map: embedding dimension -> pre-created index name + data-plane host (a *.pinecone.io name). Only the sizes listed here are accepted.
# Index requirements: dense, metric=cosine, dimension EXACTLY equal to its key, serverless. Example (single line):
# PINECONE_INDEXES={"1536":{"name":"studyforge-1536","host":"studyforge-1536-xxxxxxx.svc.aped-0000-0000.pinecone.io"}}
PINECONE_INDEXES=
# per-user = one namespace per user (strongest isolation, one-call account deletion; Starter allows 100 namespaces per index)
# shared = one namespace, isolation by the mandatory ownerId filter + PostgreSQL validation
PINECONE_NAMESPACE_MODE=per-user
# Required for dual/pinecone: keeps environments apart inside one index (lowercase letters, digits, '-'), e.g. dev or prod.
PINECONE_NAMESPACE_PREFIX=
# pinecone mode: keep ALSO writing each vector to PostgreSQL (retrieval does not read it). That makes VECTOR_STORE=pgvector a complete rollback.
# Set false only when you no longer want that rollback; then documents added afterwards have no local vector and would need re-embedding to go back.
PINECONE_KEEP_POSTGRES_VECTORS=true
PINECONE_TIMEOUT_SECONDS=10
PINECONE_MAX_RETRIES=4
# Bounded wait for freshly upserted vectors to become searchable before a document is marked READY (0 = do not wait).
PINECONE_VISIBILITY_TIMEOUT_SECONDS=30
# dual mode: time budget for the Pinecone comparison query (it never delays or changes the PostgreSQL answer beyond this).
VECTOR_SHADOW_TIMEOUT_SECONDS=5
