# Placeholders only. Copy to .env.local (git-ignored) for local development.
APP_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=8100
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
RAG_AGENT_TOKEN=               # REQUIRED: random string, at least 24 characters
ALLOW_MOCK_PROVIDER=0          # 1 enables the test-only mock provider (ignored/forbidden when APP_ENV=production)
EMBEDDING_DIMENSIONS=1536      # must match vector(1536) in the schema
MAX_UPLOAD_BYTES=26214400
MAX_PAGES=500
MAX_TEXT_CHARS=2000000
PARSE_TIMEOUT_SECONDS=60
PARSE_MEMORY_MB=1024
CHUNK_TARGET_CHARS=3200
CHUNK_OVERLAP_CHARS=400
PROVIDER_TIMEOUT_SECONDS=60
MAX_CHAT_CHARS=60000
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.30
RETRIEVAL_MAX_CONTEXT_CHARS=12000
MAX_CONCURRENT_INGESTS=2
OCR_ENABLED=false
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=studyforge-rag-agent
LANGSMITH_INCLUDE_CONTENT=false
STREAM_IDLE_TIMEOUT_SECONDS=60
