# Copy to .env.local. Placeholders only — never commit real values.

# --- Server ---
# NODE_ENV="production"   # development | test | production. In production: APP_URL must be https (loopback excepted),
#                         # ALLOW_MOCK_PROVIDER and VIDEO_UPLOADS_ENABLED are refused.
HOST="127.0.0.1"          # keep the backend private: it is only called by the frontend server and (optionally) a load balancer
PORT="4000"

# --- Database (PostgreSQL 15+ with the pgvector and pg_trgm extensions; Neon supports both) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional direct (non-pooled) URL used only by `prisma migrate`.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Public origin of the FRONTEND (browsers never talk to the backend directly) ---
APP_URL="http://localhost:3000"

# --- Authentication ---
# openssl rand -base64 48   (>= 32 chars)
BETTER_AUTH_SECRET=""
AUTH_REQUIRE_EMAIL_VERIFICATION=True
# Google sign-in (optional; set BOTH or neither). Server-side only: never put these in the frontend, git, or a NEXT_PUBLIC_ variable.
# Setup: docs/GOOGLE_OAUTH_SETUP.md. Redirect URI to register in Google Cloud: <APP_URL>/api/auth/callback/google
# AUTH_GOOGLE_ID="<client id>.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET=""

# --- Email (optional; required for verification/recovery in production) ---
# SMTP_URL="smtp://USER:PASSWORD@HOST:587"
# EMAIL_FROM="StudyForge <no-reply@example.com>"

# --- BYOK credential encryption (AES-256-GCM) ---
# openssl rand -base64 32   -> exactly 32 random bytes, base64. Keep it OUT of the database and out of git.
CREDENTIAL_ENCRYPTION_KEY=""
# Comma-separated older keys, so you can rotate CREDENTIAL_ENCRYPTION_KEY without losing stored credentials.
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=""
# Offer the deterministic "mock" provider (tests/demos ONLY; refused in production).
# ALLOW_MOCK_PROVIDER="false"

# --- rag_agent (internal AI service) ---
RAG_AGENT_URL="http://127.0.0.1:8100"
# openssl rand -hex 24  (>= 24 chars; must equal rag_agent's RAG_AGENT_TOKEN)
RAG_AGENT_TOKEN=""
# RAG_AGENT_TIMEOUT_MS="120000"     # timeout for non-streaming calls to rag_agent

# --- Embedding dimension (optional deployment DEFAULT; docs/EMBEDDING_SETTINGS_SPEC.md §2) ---
# Used only to seed a new embedding configuration whose "Embedding dimensions" field the user left blank, and still verified with a
# live request. A dimension a user has saved in Settings (stored in the database) always overrides this and is never changed by it.
# Unset = use each model's own (native) size. Allowed range 8..4096.
# EMBEDDING_DIMENSIONS="1536"

# --- Vector storage (docs/VECTOR_STORE_SPEC.md) ---
# pgvector (default) = vectors live in PostgreSQL only. dual = write both PostgreSQL and Pinecone, SERVE PostgreSQL, compare in the
# background. pinecone = serve semantic search from Pinecone (PostgreSQL stays the source of truth for text, ownership and status).
# MUST equal rag_agent's VECTOR_STORE. Pinecone credentials live ONLY in rag_agent's environment, never here.
# VECTOR_STORE="pgvector"

# --- File storage ---
STORAGE_DRIVER="local"            # local | s3 | cloudinary
LOCAL_STORAGE_DIR="./storage"     # private directory, never served statically
# S3-compatible (Cloudflare R2, MinIO, AWS S3). The bucket must be private.
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

# Cloudinary (STORAGE_DRIVER=cloudinary). Backend only: the API secret must never reach the frontend, git or logs. Setup: docs/CLOUDINARY_STORAGE.md
# Files are stored as PRIVATE (raw + authenticated) objects and only ever read/downloaded through this API.
# New uploads go to Cloudinary; documents already stored locally (keys "u/...") keep working from LOCAL_STORAGE_DIR.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="studyforge/documents"   # changing it later strands objects uploaded under the old folder
# CLOUDINARY_MAX_FILE_BYTES=""               # your plan's per-file cap, e.g. 10485760 on the Free plan (the app-wide limit stays MAX_UPLOAD_BYTES)
# Video is NOT supported (no transcription pipeline). Must stay false; refused when NODE_ENV=production.
# VIDEO_UPLOADS_ENABLED="false"

# --- Upload & usage limits (defaults shown) ---
# MAX_UPLOAD_BYTES="26214400"            # per file (25 MiB)
# MAX_FILES_PER_UPLOAD="10"
# USER_STORAGE_QUOTA_BYTES="524288000"   # per user (500 MiB)
# MAX_DOCUMENTS_PER_USER="200"
# DOWNLOAD_LINK_TTL_SECONDS="60"
# AI_DAILY_TOKEN_LIMIT="500000"          # 0 = unlimited
# AI_DAILY_REQUEST_LIMIT="300"           # 0 = unlimited
# CHAT_MAX_MESSAGE_CHARS="8000"
# CHAT_HISTORY_MAX_CHARS="24000"
# CHAT_HISTORY_MAX_MESSAGES="20"
# CHAT_MAX_DOCUMENTS="20"
# RETRIEVAL_TOP_K="6"
# RETRIEVAL_MIN_SIMILARITY="0.3"         # evidence threshold for document-only answers (0-1)
# RETRIEVAL_MAX_CONTEXT_CHARS="12000"

# --- Question generation & bank (defaults shown; see docs/PART3_SPEC.md §2) ---
# MCQ_MAX_QUESTIONS_PER_RUN="50"
# CQ_MAX_QUESTIONS_PER_RUN="20"
# GEN_TOPIC_MAX_CHARS="300"
# GEN_TEXT_MAX_CHARS="30000"             # pasted source text
# GEN_MAX_DOCUMENTS="10"
# GEN_MAX_CONTEXT_CHARS="14000"          # source characters per provider call
# GEN_BATCH_SIZE_MCQ="10"
# GEN_BATCH_SIZE_CQ="4"
# GEN_MAX_LLM_CALLS="16"                 # hard cap of provider calls per run
# GEN_MAX_OUTPUT_TOKENS="8000"
# GEN_TIMEOUT_MS="240000"
# GEN_RATE_PER_MINUTE="6"
# QUESTION_MAX_PER_USER="5000"
# COLLECTION_MAX_PER_USER="100"
# COLLECTION_MAX_QUESTIONS="500"
# SAVE_BATCH_MAX="100"
# RUN_RETENTION_DAYS="14"

# --- Exams & groups (defaults shown; see docs/PART4_SPEC.md §2) ---
# EXAM_MAX_QUESTIONS="200"
# EXAM_MAX_DURATION_MINUTES="360"
# EXAM_MAX_ATTEMPT_LIMIT="10"
# EXAM_MAX_DRAFTS_PER_USER="100"
# EXAM_GRACE_SECONDS="5"                 # latency allowance for saves/submits right at the deadline
# EXAM_SWEEP_INTERVAL_SECONDS="60"       # how often expired attempts are finalized by the sweeper
# GROUP_MAX_OWNED_PER_USER="20"
# GROUP_MAX_MEMBERSHIPS_PER_USER="50"
# GROUP_MAX_CAPACITY="500"
# GROUP_DEFAULT_CAPACITY="30"
# INVITE_DEFAULT_TTL_HOURS="168"
# INVITE_MAX_TTL_HOURS="720"
# INVITE_MAX_USES="500"
# INVITE_MAX_ACTIVE_PER_GROUP="20"
# INVITE_ATTEMPTS_PER_HOUR_USER="20"
# INVITE_ATTEMPTS_PER_HOUR_IP="60"

# --- AI feedback, study plans, usage and metrics (defaults shown; see docs/PART5_SPEC.md §2) ---
# AI_MONTHLY_TOKEN_LIMIT="0"             # 0 = unlimited (per user, calendar month UTC)
# AI_MONTHLY_REQUEST_LIMIT="0"
# ANALYSIS_MAX_ATTEMPTS="3"              # bounded retries of an AI feedback job
# ANALYSIS_MAX_OUTPUT_TOKENS="1500"
# ANALYSIS_MAX_INCORRECT_ITEMS="15"      # incorrect answers included in the analysis context
# ANALYSIS_RETRY_PER_HOUR="6"            # manual "retry AI feedback" requests per user per hour
# STUDY_PLAN_MAX_PER_USER="20"
# METRICS_RETENTION_DAYS="14"
# METRICS_FLUSH_SECONDS="30"

# --- Background jobs ---
# JOB_WORKER_ENABLED="true"
# JOB_POLL_INTERVAL_MS="1000"
# JOB_CONCURRENCY="2"

LOG_LEVEL="info"


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=""

