{
  "name": "studyforge-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "fontkit": "^2.0.4",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
